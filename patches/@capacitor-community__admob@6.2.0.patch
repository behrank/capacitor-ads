+    /// Puts the fixed-height banner on the safe-area edge, then pins the
+    /// creative to the bottom of that box so the unused points sit above it.
+    private func placeBanner(_ bannerView: GADBannerView, _ adPosition: String, _ margin: Int) {
+        guard let root = plugin?.getRootVC()?.view else { return }
+        let size = bannerView.adSize.size
+        let width = size.width > 1 ? size.width : 320
+        let height = size.height > 1 ? size.height : 50
+        let safe = root.safeAreaInsets
+        let x = (root.bounds.width - width) / 2
+        let y: CGFloat
+        if adPosition == "TOP_CENTER" {
+            y = safe.top + CGFloat(margin)
+        } else {
+            // The creative leaves about 5pt of the fixed slot empty underneath.
+            // Tuck that into the safe area so the visible ad sits on the inset.
+            y = root.bounds.height - safe.bottom - CGFloat(margin) - height + 5
+        }
+        bannerView.autoresizingMask = [.flexibleTopMargin, .flexibleLeftMargin, .flexibleRightMargin]
+        bannerView.frame = CGRect(x: x, y: y, width: width, height: height)
+        pinCreative(toBottomOf: bannerView)
+    }
+
+    /// The 320×50 slot stays fixed. A shorter creative is bottom-aligned, not
+    /// centered, so it doesn't leave a gap under the ad on any device.
+    private func pinCreative(toBottomOf bannerView: GADBannerView) {
+        let bounds = bannerView.bounds
+        for sub in bannerView.subviews {
+            let subSize = sub.frame.size
+            let subW = subSize.width > 1 ? min(subSize.width, bounds.width) : bounds.width
+            let subH = subSize.height > 1 ? min(subSize.height, bounds.height) : bounds.height
+            sub.frame = CGRect(x: (bounds.width - subW) / 2, y: bounds.height - subH, width: subW, height: subH)
         }
     }
 
